{
  "sourceLanguage": "en",
  "strings": {
    "Answer Book": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "答案书"
          }
        }
      }
    },
    "Think of your question, then open the book.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心里默念你的问题，然后翻开书。"
          }
        }
      }
    },
    "Think of your question, then tap to open the book.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心里默念你的问题，然后点一下翻开书。"
          }
        }
      }
    },
    "Open the book": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻开"
          }
        }
      }
    },
    "Page %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 页"
          }
        }
      }
    },
    "Flick the phone half shut to turn the page. Close it to start over.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把手机快速半合再打开就能翻页，合上就重新开始。"
          }
        }
      }
    },
    "Close the book": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合上"
          }
        }
      }
    },
    "Turn the page": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻一页"
          }
        }
      }
    }
  },
  "version": "1.0"
}